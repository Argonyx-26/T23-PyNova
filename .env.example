# ============================================================
# JustFormi environment — copy to .env.local and fill in.
# The app runs fully WITHOUT any of these (deterministic demo
# mode), but each one unlocks a live capability.
# ============================================================

# --- Gemini (live AI grading + embeddings + quiz generation) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase (Postgres + pgvector + Auth) ---
# https://supabase.com/dashboard → Project Settings → API
# Then run supabase/schema.sql in the SQL Editor once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SERVER ONLY. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
